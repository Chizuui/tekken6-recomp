<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions needed: game data is imported via the system file
         picker (SAF) and the log is exported the same way. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:largeHeap="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Tekken6Activity"
            android:exported="false"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:screenOrientation="landscape"
            android:launchMode="singleTask">
        </activity>
    </application>
</manifest>
